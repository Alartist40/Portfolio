{
  "name": "portfolio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "cp template.html index.html && vite",
    "build": "tsc -b && cp template.html index.html && vite build && cp dist/index.html index.html && cp dist/index.html 404.html",
